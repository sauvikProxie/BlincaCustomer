# Copy to .env for local dev. No secrets belong here.
PUBLIC_CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211
PUBLIC_APP_NAME=Blinca
# Production: PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud and
# CONVEX_SITE_URL=https://<deployment>.convex.site (this site proxies /api/auth to it).
# Optional CSP additions (runtime, space separated origins):
# CSP_IMG_HOSTS=
# CSP_FORM_ACTION_HOSTS=https://www.mollie.com
# Origin the site is served from (canonicals, JSON-LD, robots). Build-time.
# Defaults to https://blinca.se when unset; set the real origin for staging.
PUBLIC_SITE_URL=http://localhost:5173
# Mapbox default public token (public, safe in the browser). Empty = maps off.
PUBLIC_MAPBOX_ACCESS_TOKEN=
